# Copy to .env; never commit .env. Every key the apps read is listed here with a safe local default.
KILN_ENV=local
KILN_LOG_LEVEL=INFO
KILN_DATABASE_URL=postgresql+psycopg://kiln:kiln@127.0.0.1:5432/kiln
KILN_S3_ENDPOINT=http://127.0.0.1:9000
KILN_S3_BUCKET=kiln-assets
KILN_S3_ACCESS_KEY=kiln
KILN_S3_SECRET_KEY=kiln-local-secret
KILN_CORS_ORIGINS=http://127.0.0.1:5173
# AI features stay off until a key is set; the app then uses a deterministic offline tagger.
KILN_ANTHROPIC_API_KEY=
KILN_AI_MONTHLY_BUDGET_USD=5
# Web (Vite exposes only VITE_* to the browser)
VITE_KILN_API_URL=http://127.0.0.1:8000
