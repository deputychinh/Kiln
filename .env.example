# Copy to .env; never commit .env. Every key the apps read is listed here with a safe local default.
KILN_ENV=local
KILN_LOG_LEVEL=INFO
# Worker: seconds between maintenance runs across all workers (KILN-22)
KILN_MAINTENANCE_INTERVAL_SECONDS=3600
# Worker: a fresh process after this many jobs or this much peak memory (KILN-25)
KILN_WORKER_MAX_JOBS=200
KILN_WORKER_MAX_RSS_MB=1024
# Worker: a running job gets this long to finish after a stop, then the process exits (KILN-28).
# At most 120 (so a frozen job is still killed inside its lease). The orchestrator's stop timeout
# must be at least this + 10 s (Kubernetes terminationGracePeriodSeconds).
KILN_JOB_STOP_GRACE_SECONDS=60
KILN_DATABASE_URL=postgresql+psycopg://kiln:kiln@127.0.0.1:5432/kiln
KILN_S3_ENDPOINT=http://127.0.0.1:8333
KILN_S3_BUCKET=kiln-assets
KILN_S3_ACCESS_KEY=kiln
KILN_S3_SECRET_KEY=kiln-local-secret
# Storage circuit breaker and bulkhead (KILN-23): consecutive failures to open, cool-down, concurrent calls, wait for a slot
KILN_STORAGE_BREAKER_FAILURES=5
KILN_STORAGE_BREAKER_COOLDOWN_SECONDS=30
KILN_STORAGE_MAX_CONCURRENT=16
KILN_STORAGE_BULKHEAD_WAIT_SECONDS=0.5
KILN_CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:4173"]
# AI features stay off until a key is set; the app then uses a deterministic offline tagger.
KILN_ANTHROPIC_API_KEY=
KILN_AI_MONTHLY_BUDGET_USD=5
# Web (Vite exposes only VITE_* to the browser)
VITE_KILN_API_URL=http://127.0.0.1:8000
