{
  "name": "@kiln/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../../services/api/openapi.json -o src/api/kiln.schema.ts"
  },
  "dependencies": {
    "@kiln/ui": "0.1.0",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  }
}
