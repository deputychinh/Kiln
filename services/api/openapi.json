            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Probe result."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
