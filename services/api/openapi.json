  "components": {
    "schemas": {
      "AssetDetailOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url",
            "description": "Preview of the newest ready version (signed, 15 minutes)."
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/VersionOut"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "created_at",
          "updated_at",
          "versions"
        ],
        "title": "AssetDetailOut",
        "description": "An asset with its versions by number."
      },
      "AssetKind": {
        "type": "string",
        "enum": [
          "image",
          "model"
        ],
        "title": "AssetKind",
        "description": "What an asset holds; decides how it is previewed."
      },
      "AssetOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url",
            "description": "Preview of the newest ready version (signed, 15 minutes)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "created_at",
          "updated_at"
        ],
        "title": "AssetOut",
        "description": "An asset."
      },
      "AssetPageOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AssetOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AssetPageOut",
        "description": "A newest-first page; pass `next_cursor` back to get the next one."
      },
      "CreateAssetRequest": {
        "properties": {
          "file_name": {
            "type": "string",
            "maxLength": 2000,
            "title": "File Name"
          },
          "content_type": {
            "type": "string",
            "maxLength": 255,
            "title": "Content Type"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "name": {
            "type": "string",
            "maxLength": 1000,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_name",
          "content_type",
          "size_bytes",
          "name"
        ],
        "title": "CreateAssetRequest",
        "description": "A new asset and its first file."
      },
      "FailureReason": {
        "type": "string",
        "enum": [
          "UPLOAD_CHANGED",
          "UNREADABLE_IMAGE",
          "IMAGE_TOO_LARGE",
          "PROCESSING_GAVE_UP",
          "UPLOAD_EXPIRED",
          "UNREADABLE_MODEL",
          "MODEL_TOO_LARGE"
        ],
        "title": "FailureReason",
        "description": "Why a version ended `failed`; shown to people, so stable and human-mappable."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Probe result."
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "description": "Result of a health or readiness probe."
      },
      "PendingUploadOut": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/AssetOut"
          },
          "version": {
            "$ref": "#/components/schemas/VersionOut"
          },
          "upload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UploadOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signed form for the file. A first creation always has one; a replay has null once the version left pending_upload."
          }
        },
