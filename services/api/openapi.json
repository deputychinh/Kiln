            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Database or storage unavailable or busy; retry after `Retry-After`.",
            "content": {
              "application/problem+json": {
                "schema": {
