{
  "name": "kiln",
  "private": true,
  "description": "Kiln monorepo: web app, design system and CLI (npm workspaces) plus repo tooling.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  }
}
