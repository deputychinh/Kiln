{
  "name": "@kiln/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Kiln design system: tokens and React components.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" \".storybook/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "storybook": "storybook dev --port 6006 --no-open",
    "build": "storybook build --quiet --output-dir storybook-static",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "imports": {
    "#ui/*": "./src/*"
  }
}
